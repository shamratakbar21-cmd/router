APP_NAME="NUR WinControl"
APP_ENV=production
APP_DEBUG=false
APP_URL="https://{{WINCONTROL_FQDN}}:8443"
DB_CONNECTION=sqlite
# DB_DATABASE=/opt/nur-wincontrol/database/database.sqlite
QUEUE_CONNECTION=database
SESSION_DRIVER=database
CACHE_STORE=database
NUR_LICENSE_SIGNING_KEY_ID="{{KEY_ID}}"
NUR_LICENSE_SIGNING_PRIVATE_KEY="{{BASE64_PRIVATE_KEY}}"
# Never place compromised keys in the trusted set; list them separately if needed:
# NUR_LICENSE_COMPROMISED_PUBLIC_KEYS=
