# Pilot router placeholders — replace before use. Do not commit real values.
ROUTER_NAME="{{ROUTER_NAME}}"
NAMESPACE_NAME="{{NAMESPACE_NAME}}"
MANAGEMENT_INTERFACE="{{MGMT_IFACE}}"
MANAGEMENT_CIDR="{{MGMT_IPV4}}/{{MGMT_PREFIX}}"
APPLIANCE_SSH_HOST="{{MGMT_IPV4}}"
APPLIANCE_SSH_USER="nur-mgmt"
APPLIANCE_SSH_PORT="22"
# Paste a single known_hosts line verified on the appliance console:
# {{MGMT_IPV4}} ssh-ed25519 AAAA...
KNOWN_HOSTS_LINE="{{KNOWN_HOSTS_LINE}}"
