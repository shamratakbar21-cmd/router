#!/bin/sh
# NurRouterOS recoverable update helper (ext4/sysupgrade oriented).
# Does NOT implement A/B automatic rollback — see docs/APPLIANCE-UPDATES.md.
set -eu

METADATA=""
IMAGE=""
ALLOW_DOWNGRADE=0
LOCK_DIR="/etc/nurrouter/runtime/update.lock"
UPDATE_PUBKEYS="/etc/nurrouter/update-public-keys.json"
PRODUCT_VERSION_FILE="/etc/nurrouter/product-version"
INSTALL_LOCK="/etc/nurrouter-installer/install.lock"

say() { printf '%s\n' "$*"; }
die() { say "ERROR: $*" >&2; exit 1; }

usage() {
    cat <<'EOF'
usage: nur-update --metadata <file.json> --image <payload> [--allow-downgrade]
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --metadata) METADATA="$2"; shift 2 ;;
        --image) IMAGE="$2"; shift 2 ;;
        --allow-downgrade) ALLOW_DOWNGRADE=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown argument: $1" ;;
    esac
done

[ -n "${METADATA}" ] && [ -f "${METADATA}" ] || die "metadata file required"
[ -n "${IMAGE}" ] && [ -f "${IMAGE}" ] || die "image payload required"
[ -f "${PRODUCT_VERSION_FILE}" ] || die "missing ${PRODUCT_VERSION_FILE}"
command -v jq >/dev/null 2>&1 || die "jq required"
command -v sha256sum >/dev/null 2>&1 || die "sha256sum required"
command -v sysupgrade >/dev/null 2>&1 || die "sysupgrade required"

if [ -e "${INSTALL_LOCK}" ]; then
    die "installer lock present at ${INSTALL_LOCK}; refuse concurrent update/install"
fi

if [ -d "${LOCK_DIR}" ]; then
    die "update already in progress (${LOCK_DIR})"
fi

mkdir -p "$(dirname "${LOCK_DIR}")"
mkdir "${LOCK_DIR}" || die "unable to acquire update lock"
trap 'rmdir "${LOCK_DIR}" 2>/dev/null || true' EXIT INT TERM

current_version="$(tr -d '\n' < "${PRODUCT_VERSION_FILE}")"
product="$(jq -r '.product // empty' "${METADATA}")"
version="$(jq -r '.version // empty' "${METADATA}")"
arch="$(jq -r '.arch // empty' "${METADATA}")"
min_free_kb="$(jq -r '.min_free_kb // 65536' "${METADATA}")"
image_sha="$(jq -r '.image_sha256 // empty' "${METADATA}")"
signature="$(jq -r '.signature // empty' "${METADATA}")"
key_id="$(jq -r '.key_id // empty' "${METADATA}")"

[ "${product}" = "NurRouterOS" ] || die "metadata product mismatch (got '${product}')"
[ -n "${version}" ] || die "metadata missing version"
[ "${arch}" = "x86_64" ] || die "incompatible architecture '${arch}' (appliance is x86_64)"
[ -n "${image_sha}" ] || die "metadata missing image_sha256"
[ -n "${signature}" ] || die "metadata missing signature"
[ -n "${key_id}" ] || die "metadata missing key_id"

# Version ordering: refuse older/equal unless audited downgrade.
version_gt() {
    # Best-effort dotted compare; non-numeric suffixes sort lexicographically via sort -V.
    printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1 | grep -qx "$1"
}

if [ "${ALLOW_DOWNGRADE}" -ne 1 ]; then
    if [ "${version}" = "${current_version}" ]; then
        die "refusing same version ${version} without --allow-downgrade"
    fi
    if ! version_gt "${version}" "${current_version}"; then
        die "refusing older/equal version ${version} (current ${current_version}); pass --allow-downgrade for audited recovery"
    fi
else
    say "AUDITED recovery downgrade requested: ${current_version} -> ${version}"
fi

avail_kb="$(df -Pk / | awk 'NR==2 {print $4}')"
[ "${avail_kb}" -ge "${min_free_kb}" ] || die "insufficient free space (${avail_kb} KiB < ${min_free_kb} KiB)"

actual_sha="$(sha256sum "${IMAGE}" | awk '{print $1}')"
[ "${actual_sha}" = "${image_sha}" ] || die "payload digest mismatch (expected ${image_sha}, got ${actual_sha})"

[ -f "${UPDATE_PUBKEYS}" ] || die "missing update public keys at ${UPDATE_PUBKEYS}"
pubkey="$(jq -r --arg id "${key_id}" '.keys[] | select(.key_id==$id and .purpose=="update") | .public_key_pem // .public_key // empty' "${UPDATE_PUBKEYS}" | head -n1)"
[ -n "${pubkey}" ] || die "update key_id '${key_id}' not trusted (or purpose!=update)"

# Canonical signed body excludes the signature field.
body="$(jq -c 'del(.signature)' "${METADATA}")"
body_file="$(mktemp)"
sig_file="$(mktemp)"
pub_file="$(mktemp)"
printf '%s' "${body}" > "${body_file}"
printf '%s' "${signature}" | tr -d '\n' > "${sig_file}"
printf '%s\n' "${pubkey}" > "${pub_file}"

if command -v nur-update-verify >/dev/null 2>&1; then
    nur-update-verify --public-key-file "${pub_file}" --body-file "${body_file}" --signature-b64-file "${sig_file}" \
        || { rm -f "${body_file}" "${sig_file}" "${pub_file}"; die "update signature verification failed"; }
elif command -v openssl >/dev/null 2>&1; then
    # openssl pkeyutl path for lab/dev when nur-update-verify is absent.
    printf '%s' "${signature}" | base64 -d > "${sig_file}.bin" 2>/dev/null || die "signature base64 decode failed"
    openssl pkeyutl -verify -pubin -inkey "${pub_file}" -sigfile "${sig_file}.bin" -in "${body_file}" >/dev/null 2>&1 \
        || { rm -f "${body_file}" "${sig_file}" "${sig_file}.bin" "${pub_file}"; die "update signature verification failed"; }
    rm -f "${sig_file}.bin"
else
    rm -f "${body_file}" "${sig_file}" "${pub_file}"
    die "no update signature verifier available (nur-update-verify or openssl)"
fi
rm -f "${body_file}" "${sig_file}" "${pub_file}"

say "Preflight OK: ${current_version} -> ${version}; invoking sysupgrade -c (config preserve)."
say "NOTE: no automatic rollback partition exists; recover with installer if this fails."

# -c keep config files; do not reboot here so the caller can observe the result when possible.
# sysupgrade typically reboots; that is expected on success.
sysupgrade -c "${IMAGE}"
