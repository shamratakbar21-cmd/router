#!/bin/sh
# Constrained management entrypoint for the nur-mgmt SSH identity.
# Dropbear authorized_keys should use:
# command="/usr/sbin/nur-mgmt-ssh",no-port-forwarding,no-agent-forwarding,no-X11-forwarding,no-pty
set -eu

ORIGINAL_COMMAND="${SSH_ORIGINAL_COMMAND:-}"

reject() {
    printf 'nur-mgmt-ssh: rejected: %s\n' "$*" >&2
    exit 1
}

[ -n "${ORIGINAL_COMMAND}" ] || reject 'empty command'

run_privileged() {
    # Prefer the tiny setuid elevator (no sudo package required), then sudo, then root.
    if [ -u /usr/sbin/nur-mgmt-elev ] || [ -x /usr/sbin/nur-mgmt-elev ]; then
        exec /usr/sbin/nur-mgmt-elev "$@"
    fi
    if command -v sudo >/dev/null 2>&1; then
        exec sudo -n "$@"
    fi
    if [ "$(id -u)" -eq 0 ]; then
        exec "$@"
    fi
    reject 'privileged helper unavailable (nur-mgmt-elev/sudo missing and not root)'
}

# Commands are tokenized only after metacharacters have been rejected.
case "${ORIGINAL_COMMAND}" in
    *[!A-Za-z0-9_./\ -]*) reject 'invalid command characters' ;;
esac
set -f
set -- ${ORIGINAL_COMMAND}
valid_overlay() {
    case "$1" in /tmp/nurrouter-overlay-*) ;; *) return 1 ;; esac
    suffix="${1#/tmp/nurrouter-overlay-}"
    case "${suffix}" in ""|*[!A-Za-z0-9_-]*) return 1 ;; esac
    [ "${#suffix}" -le 80 ]
}
case "$1" in
    scp)
        shift
        # Only sink mode is needed for management uploads; no arbitrary flags.
        while [ "$#" -gt 0 ]; do
            case "$1" in -v|-r|-d) shift ;; *) break ;; esac
        done
        [ "$#" -eq 2 ] && [ "$1" = -t ] && valid_overlay "$2" || reject 'invalid scp target'
        exec /usr/bin/scp -r -t "$2"
        ;;
    /usr/sbin/nur-runtimectl)
        case "${2:-}" in
            observe) [ "$#" -eq 2 ] || reject 'unexpected arguments' ;;
            apply)
                [ "$#" -eq 8 ] && [ "$3" = --overlay ] && valid_overlay "$4" && [ "$5" = --operation ] && [ "$7" = --safe-mode-seconds ] || reject 'invalid apply'
                ;;
            confirm) [ "$#" -eq 4 ] && [ "$3" = --operation ] || reject 'invalid confirm' ;;
            *) reject 'unsupported operation' ;;
        esac
        run_privileged "$@"
        ;;
    /bin/rm)
        [ "$#" -eq 4 ] && [ "$2" = -rf ] && [ "$3" = -- ] && valid_overlay "$4" || reject 'invalid cleanup'
        exec /bin/rm -rf -- "$4"
        ;;
    *) reject 'unsupported command' ;;
esac
