#!/bin/sh
# Optional OpenSSL-based verifier (fallback when Go binary is unavailable).
set -eu
CANONICAL="${1:?}"; SIG="${2:?}"; PUB_RAW="${3:?}"
[ -s "${CANONICAL}" ] && [ -s "${SIG}" ] && [ -s "${PUB_RAW}" ] || exit 1
command -v openssl >/dev/null 2>&1 || exit 1
TMP="$(mktemp -d)"; trap 'rm -rf "${TMP}"' EXIT
{ printf '\060\052\060\005\006\003\053\145\160\003\041\000'; cat "${PUB_RAW}"; } > "${TMP}/pub.der"
openssl pkey -pubin -inform DER -in "${TMP}/pub.der" -outform PEM -out "${TMP}/pub.pem" 2>/dev/null || exit 1
openssl pkeyutl -verify -pubin -inkey "${TMP}/pub.pem" -rawin -in "${CANONICAL}" -sigfile "${SIG}" >/dev/null 2>&1
