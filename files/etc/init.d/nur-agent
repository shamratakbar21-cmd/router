#!/bin/sh /etc/rc.common

START=94
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/nur-agent \
        --socket /var/run/nur-agent.sock \
        --socket-mode 0600 \
        --socket-group root \
        --allowed-peer-uids 0 \
        --allowed-peer-gids 0 \
        --operation-timeout 15s
    procd_set_param respawn
    procd_close_instance
}
