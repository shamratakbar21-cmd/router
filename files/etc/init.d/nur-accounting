#!/bin/sh /etc/rc.common
# Independent replay must survive BRAS engine restarts and disabled admission.
START=95
USE_PROCD=1
start_service() {
    [ -d /etc/nurrouter/accounting ] || mkdir -m700 /etc/nurrouter/accounting || return 1
    procd_open_instance
    procd_set_param command /usr/sbin/nur-accounting run
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance
}
